        <source>This terminal is the host's — ask them to let you type</source>
        <target>Questo terminale è dell’host — chiedigli di lasciarti scrivere</target>
      </trans-unit>
      <trans-unit id="45">
        <source>%name% shared a terminal: %title%</source>
        <target>%name% ha condiviso un terminale: %title%</target>
      </trans-unit>
      <trans-unit id="46">
        <source>[no longer shared]</source>
        <target>[non più condiviso]</target>
      </trans-unit>
      <trans-unit id="47">
        <source>(ended)</source>
        <target>(terminato)</target>
      </trans-unit>
      <trans-unit id="48">
        <source>You can type in the shared terminals</source>
        <target>Puoi scrivere nei terminali condivisi</target>
      </trans-unit>
      <trans-unit id="49">
        <source>The shared terminals are read-only for you again</source>
        <target>I terminali condivisi sono di nuovo in sola lettura per te</target>
      </trans-unit>
      <trans-unit id="50">
        <source>No terminal to share — open one first</source>
        <target>Nessun terminale da condividere — aprine uno prima</target>
      </trans-unit>
      <trans-unit id="51">
        <source>shared — pick to stop</source>
        <target>condiviso — scegli per interrompere</target>
      </trans-unit>
      <trans-unit id="52">
        <source>Share which terminal?</source>
        <target>Quale terminale condividere?</target>
      </trans-unit>
      <trans-unit id="53">
        <source>Let them type in shared terminals</source>
        <target>Lascia scrivere nei terminali condivisi</target>
      </trans-unit>
      <trans-unit id="54">
        <source>Stop them typing in shared terminals</source>
        <target>Smetti di lasciar scrivere nei terminali condivisi</target>
      </trans-unit>
      <trans-unit id="55">
        <source>%name% shared localhost:%port% — open http://127.0.0.1:%local%</source>
        <target>%name% ha condiviso localhost:%port% — apri http://127.0.0.1:%local%</target>
      </trans-unit>
      <trans-unit id="56">
        <source>%name% stopped sharing localhost:%port%</source>
        <target>%name% non condivide più localhost:%port%</target>
      </trans-unit>
      <trans-unit id="57">
        <source>Share this project first</source>
        <target>Condividi prima questo progetto</target>
      </trans-unit>
      <trans-unit id="58">
        <source>Share which local port? (a dev server: 8000, say)</source>
        <target>Quale porta locale condividere? (un server di sviluppo, ad es. 8000)</target>
      </trans-unit>
      <trans-unit id="59">
        <source>Not a port: %port%</source>
        <target>Non è una porta: %port%</target>
      </trans-unit>
      <trans-unit id="60">
        <source>Share which server?</source>
        <target>Quale server condividere?</target>
      </trans-unit>
      <trans-unit id="61">
        <source>Another port…</source>
        <target>Un’altra porta…</target>
      </trans-unit>
      <trans-unit id="62">
        <source>The host shares no server</source>
        <target>L’host non condivide alcun server</target>
      </trans-unit>
      <trans-unit id="63">
        <source>Shared servers</source>
        <target>Server condivisi</target>
      </trans-unit>
      <trans-unit id="64">
        <source>Address copied: %url%</source>
        <target>Indirizzo copiato: %url%</target>
      </trans-unit>
