        <source>Let them run the run configurations</source>
        <target>Permettigli di avviare le configurazioni di esecuzione</target>
      </trans-unit>
      <trans-unit id="66">
        <source>Stop them running the run configurations</source>
        <target>Non permettergli più di avviare le configurazioni di esecuzione</target>
      </trans-unit>
