        <source>Run on the host</source>
        <target>Esegui sull’host</target>
      </trans-unit>
      <trans-unit id="69">
        <source>The host has not let you run its configurations</source>
        <target>L’host non ti permette di avviare le sue configurazioni</target>
      </trans-unit>
      <trans-unit id="70">
        <source>The host has no run configuration</source>
        <target>L’host non ha alcuna configurazione di esecuzione</target>
      </trans-unit>
